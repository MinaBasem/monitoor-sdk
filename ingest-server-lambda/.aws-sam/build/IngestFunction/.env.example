# Required — Neon HTTP SQL endpoint
NEON_URL=https://YOUR_NEON_ENDPOINT/sql

# Required — Full PostgreSQL connection string
NEON_CONNECTION_STR=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require

# Optional — Neon Management API key
# When set, the last active Lambda invocation automatically suspends Neon compute
# after all writes complete. Obtain from: console.neon.tech → Account → API Keys.
# If not set, Neon falls back to its built-in 5-minute idle timeout.
NEON_API_KEY=
