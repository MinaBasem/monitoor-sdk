# Required — Neon HTTP SQL endpoint
NEON_URL=https://YOUR_NEON_ENDPOINT/sql

# Required — Full PostgreSQL connection string
NEON_CONNECTION_STR=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require

# Optional — Neon Management API key
# Only needed when NEON_SUSPEND_AFTER_INGEST=true
# Obtain from: console.neon.tech → Account → API Keys
NEON_API_KEY=

# Optional — suspend Neon compute after each successful ingest (default: false)
# Read the "Neon Compute Suspend" section in LAMBDA.md before enabling
NEON_SUSPEND_AFTER_INGEST=false
